<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    This props file is automatically imported by NuGet before the project file.
    It sets up properties needed for TypeScript 7 compilation and ensures
    this NuGet package takes precedence over older TypeScript NuGet packages.
  -->
  
  <PropertyGroup>
    <!-- Mark that this TypeScript MSBuild package has been imported -->
    <TypeScriptMSBuildVersion>7.0.1</TypeScriptMSBuildVersion>
    <TypeScriptNuGetToolsVersion>7.0</TypeScriptNuGetToolsVersion>
    <UsingMicrosoftTsGo>true</UsingMicrosoftTsGo>
    
    <!-- Detect platform and set path to the correct platform-specific tsc executable -->
    <!-- Users can override TscExe in their project file if needed -->
    <TscRuntimeIdentifier Condition="'$(OS)' == 'Windows_NT' AND '$(PROCESSOR_ARCHITECTURE)' == 'AMD64'">win32-x64</TscRuntimeIdentifier>
    <TscRuntimeIdentifier Condition="'$(OS)' == 'Windows_NT' AND '$(PROCESSOR_ARCHITECTURE)' == 'ARM64'">win32-arm64</TscRuntimeIdentifier>
    <TscRuntimeIdentifier Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true' AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64'">darwin-x64</TscRuntimeIdentifier>
    <TscRuntimeIdentifier Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true' AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">darwin-arm64</TscRuntimeIdentifier>
    <TscRuntimeIdentifier Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true' AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64'">linux-x64</TscRuntimeIdentifier>
    <TscRuntimeIdentifier Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true' AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">linux-arm64</TscRuntimeIdentifier>
    <TscExe Condition="'$(TscExe)' == '' AND '$(OS)' == 'Windows_NT'">$(MSBuildThisFileDirectory)..\tools\runtimes\$(TscRuntimeIdentifier)\tsc.exe</TscExe>
    <TscExe Condition="'$(TscExe)' == '' AND '$(OS)' != 'Windows_NT'">$(MSBuildThisFileDirectory)..\tools\runtimes\$(TscRuntimeIdentifier)\tsc</TscExe>
    
    <!-- Keep TypeScriptEnabled true so VS shows the TypeScript Build page in project properties. -->
    <TypeScriptEnabled Condition="'$(TypeScriptEnabled)' == ''">true</TypeScriptEnabled>

    <!-- Register the TypeScript Build property page in Visual Studio project properties.
         Without these GUIDs the TypeScript Build tab is missing from the project properties
         dialog in .NET web application projects. The GUID matches the page registered by
         the VS TypeScript language service VSIX. -->
    <CfgPropertyPagesGuidsAddCSharp Condition="'$(CfgPropertyPagesGuidsAddCSharp)' == ''">{d4683cae-88c4-4b85-863d-ac8014f3ba36}</CfgPropertyPagesGuidsAddCSharp>
    <CfgPropertyPagesGuidsAddVB Condition="'$(CfgPropertyPagesGuidsAddVB)' == ''">{d4683cae-88c4-4b85-863d-ac8014f3ba36}</CfgPropertyPagesGuidsAddVB>
    <CfgPropertyPagesGuidsAddTypeScript Condition="'$(CfgPropertyPagesGuidsAddTypeScript)' == ''">{d4683cae-88c4-4b85-863d-ac8014f3ba36}</CfgPropertyPagesGuidsAddTypeScript>
    
    <!-- Mark that we want to use the new TS7 targets -->
    <UseTypeScript7>true</UseTypeScript7>
    
    <!-- TypeScript configuration defaults (mirroring Microsoft.TypeScript.Default.props) -->
    <TypeScriptTarget Condition="'$(TypeScriptTarget)' == ''">ES2020</TypeScriptTarget>
    <TypeScriptAllowJS Condition="'$(TypeScriptAllowJS)' == ''">false</TypeScriptAllowJS>
    <TypeScriptCompileOnSaveEnabled Condition="'$(TypeScriptCompileOnSaveEnabled)' == ''">true</TypeScriptCompileOnSaveEnabled>
    <TypeScriptNoImplicitAny Condition="'$(TypeScriptNoImplicitAny)' == ''">false</TypeScriptNoImplicitAny>
    <TypeScriptRemoveComments Condition="'$(TypeScriptRemoveComments)' == ''">false</TypeScriptRemoveComments>
    <TypeScriptGeneratesDeclarations Condition="'$(TypeScriptGeneratesDeclarations)' == ''">false</TypeScriptGeneratesDeclarations>
    <TypeScriptSourceMap Condition="'$(TypeScriptSourceMap)' == ''">true</TypeScriptSourceMap>
    <TypeScriptNoEmitOnError Condition="'$(TypeScriptNoEmitOnError)' == ''">true</TypeScriptNoEmitOnError>
  </PropertyGroup>
  
  <!-- Clear old compilation dependencies so only our targets run. -->
  <PropertyGroup>
    <CompileTypeScriptDependsOn></CompileTypeScriptDependsOn>
  </PropertyGroup>
</Project>

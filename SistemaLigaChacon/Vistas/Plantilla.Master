<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Plantilla.master.cs" Inherits="SistemaLigaChacon.Vistas.Plantilla" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title><%: String.IsNullOrWhiteSpace(Page.Title) ? "Liga Arnaldo Chacon Soto" : Page.Title %></title>
    <meta name="description" content="<%: String.IsNullOrWhiteSpace(Page.MetaDescription) ? "Portal oficial de la Liga Arnaldo Chacon Soto. Consulta clubes, posiciones, calendario, resultados y campeones del torneo." : Page.MetaDescription %>" />
    <link rel="canonical" href="<%= HttpUtility.HtmlAttributeEncode(Request.Url.GetLeftPart(UriPartial.Authority) + Request.Url.AbsolutePath) %>" />
    <meta property="og:site_name" content="Liga Arnaldo Chacon Soto" />
    <meta property="og:locale" content="es_HN" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="<%: String.IsNullOrWhiteSpace(Page.Title) ? "Liga Arnaldo Chacon Soto" : Page.Title %>" />
    <meta property="og:description" content="<%: String.IsNullOrWhiteSpace(Page.MetaDescription) ? "Resultados, posiciones, calendario y clubes de la Liga Arnaldo Chacon Soto." : Page.MetaDescription %>" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="<%=ResolveUrl("~/Images/Logo Liga.jpeg") %>" type="image/jpeg" />
    <!--begin::Theme Init (prevents flash of incorrect theme on load, #6043)-->
    <script>
        (() => {
            'use strict';
            const root = document.documentElement;

            // Applications with their own theming opt out of AdminLTE's color mode
            // entirely, here as well as in the bundle.
            if (root.getAttribute('data-lte-color-mode') === 'off') {
                return;
            }

            const STORAGE_KEY = 'lte-theme';
            let stored = null;
            try {
                stored = localStorage.getItem(STORAGE_KEY);
            } catch {
                // localStorage may be unavailable (private mode, sandboxed iframe).
            }
            // Mirror the precedence in color-mode.ts: the visitor's stored choice
            // wins, then a theme this page declared itself, then the OS preference.
            const authored = root.getAttribute('data-bs-theme');
            let resolved = 'light';
            if (stored === 'dark' || stored === 'light') {
                resolved = stored;
            } else if (authored === 'dark' || authored === 'light') {
                resolved = authored;
            } else if (globalThis.matchMedia('(prefers-color-scheme: dark)').matches) {
                resolved = 'dark';
            }
            root.setAttribute('data-bs-theme', resolved);
            root.style.colorScheme = resolved;
            // Flag values computed here, so the bundle does not mistake them for a
            // theme the page declared and stop following the OS preference.
            if (resolved !== authored) {
                root.setAttribute('data-lte-theme-resolved', '');
            }
        })();
    </script>
    <!--end::Theme Init-->

    <!--begin::Accessibility Meta Tags-->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#007bff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)" />
    <!--end::Accessibility Meta Tags-->

    <!--begin::Accessibility Features-->
    <!-- Skip links will be dynamically added by accessibility.js -->
    <meta name="supported-color-schemes" content="light dark" />
    <link rel="preload" href="<%=ResolveUrl("~/Vistas/css/adminlte.css") %>" as="style" />
    <!--end::Accessibility Features-->


    <!--begin::Third Party Plugin(OverlayScrollbars)-->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/styles/overlayscrollbars.min.css"
        crossorigin="anonymous" />
    <!--end::Third Party Plugin(OverlayScrollbars)-->

    <!--begin::Third Party Plugin(Bootstrap Icons)-->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
        crossorigin="anonymous" />
    <!--end::Third Party Plugin(Bootstrap Icons)-->

    <!--begin::Required Plugin(AdminLTE)-->
    <link rel="stylesheet" href="./css/adminlte.css" />
    <!--end::Required Plugin(AdminLTE)-->

    <!-- apexcharts -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/apexcharts@3.37.1/dist/apexcharts.css"
        integrity="sha256-4MX+61mt9NVvvuPjUWdUdyfZfxSB1/Rf9WtqRHgG5S0="
        crossorigin="anonymous" />

    <!-- jsvectormap -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/jsvectormap@1.5.3/dist/css/jsvectormap.min.css"
        integrity="sha256-+uGLJmmTKOqBr+2E6KDYs/NRsHxSkONXFHUL0fy2O/4="
        crossorigin="anonymous" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <form id="form1" runat="server">
        <div>
            <div class="app-wrapper">
                <!--begin::Header-->
                <nav class="app-header navbar navbar-expand bg-body">
                    <!--begin::Container-->
                    <div class="container-fluid">
                        <!--begin::Start Navbar Links-->
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a
                                    class="nav-link"
                                    data-lte-toggle="sidebar"
                                    href="#"
                                    role="button"
                                    aria-label="Mostrar u ocultar menu">
                                    <i class="bi bi-list"></i>
                                </a>
                            </li>
                            <li class="nav-item d-none d-md-block">
                                <a href="<%=ResolveUrl("~/Vistas/Home.aspx") %>" class="nav-link fw-semibold">Liga Arnaldo Chacon Soto</a>
                            </li>
                        </ul>
                        <!--end::Start Navbar Links-->

                        <!--begin::End Navbar Links-->
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <asp:Literal ID="litUsuarioActual" runat="server" />
                            </li>
                            <li class="nav-item">
                                <asp:HyperLink ID="lnkAcceso" runat="server" CssClass="nav-link" Text="Iniciar sesion" />
                            </li>
                            <li class="nav-item">
                                <asp:LinkButton ID="btnCerrarSesion" runat="server" CssClass="nav-link" Text="Cerrar sesion" Visible="false" OnClick="btnCerrarSesion_Click" />
                            </li>
                        </ul>
                        <!--end::End Navbar Links-->
                    </div>
                    <!--end::Container-->
                </nav>
                <!--end::Header-->
                <!--begin::Sidebar-->
                <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
                    <!--begin::Sidebar Brand-->
                    <div class="sidebar-brand">
                        <!--begin::Brand Link-->
                        <a href="<%=ResolveUrl("~/Vistas/Home.aspx") %>" class="brand-link">
                            <!--begin::Brand Text-->
                            <img src="<%=ResolveUrl("~/Images/Logo Liga.jpeg") %>" alt="Escudo de la liga" class="brand-image opacity-75 shadow" />
                            <span class="brand-text fw-light">Liga Arnaldo Chacon Soto</span>
                            <!--end::Brand Text-->
                        </a>
                        <!--end::Brand Link-->
                    </div>
                    <!--end::Sidebar Brand-->

                    <!--begin::Sidebar Wrapper-->
                    <div class="sidebar-wrapper">
                        <nav class="mt-2" aria-label="Navegacion principal">
                            <!--begin::Sidebar Menu-->
                            <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" data-accordion="false" id="navigation">
                                <li class="nav-header">PORTAL DEPORTIVO</li>
                                <li class="nav-item">
                                    <a href="<%=ResolveUrl("~/Vistas/Home.aspx") %>" class="nav-link">
                                        <i class="nav-icon bi bi-house-door"></i>
                                        <p>Inicio</p>
                                    </a>
                                </li>
                                <li class="nav-header">CAMPEONATO</li>
                                <li class="nav-item">
                                    <a href="<%=ResolveUrl("~/Vistas/Posiciones.aspx") %>" class="nav-link">
                                        <i class="nav-icon bi bi-trophy"></i>
                                        <p>Posiciones</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="<%=ResolveUrl("~/Vistas/Home.aspx#partidos") %>" class="nav-link">
                                        <i class="nav-icon bi bi-calendar3"></i>
                                        <p>Partidos y resultados</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="<%=ResolveUrl("~/Vistas/Equipos.aspx") %>" class="nav-link">
                                        <i class="nav-icon bi bi-shield"></i>
                                        <p>Equipos</p>
                                    </a></li>
                                <li class="nav-item">
                                    <a href="<%=ResolveUrl("~/Vistas/Campeones.aspx") %>" class="nav-link">
                                        <i class="nav-icon bi bi-award"></i>
                                        <p>Campeones</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="<%=ResolveUrl("~/Vistas/Alineaciones.aspx") %>" class="nav-link">
                                        <i class="nav-icon bi bi-people"></i>
                                        <p>Alineaciones</p>
                                    </a>
                                </li>
                                <asp:PlaceHolder ID="phAdminMenu" runat="server" Visible="false">
                                    <li class="nav-header">ADMINISTRACION</li>
                                    <li class="nav-item">
                                        <a href="<%=ResolveUrl("~/Vistas/AdministrarEquipos.aspx") %>" class="nav-link">
                                            <i class="nav-icon bi bi-shield-plus"></i>
                                            <p>Administrar equipos</p>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <asp:HyperLink ID="lnkAdminPartidos" runat="server" NavigateUrl="~/Vistas/AdministrarPartidos.aspx" CssClass="nav-link" Text="Partidos y resultados" />
                                    </li>
                                    <li class="nav-item">
                                        <a href="<%=ResolveUrl("~/Vistas/AdministrarSanciones.aspx") %>" class="nav-link">
                                            <i class="nav-icon bi bi-card-list"></i>
                                            <p>Sanciones</p>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <asp:HyperLink ID="lnkAdminUsuarios" runat="server" NavigateUrl="~/Vistas/AdministrarUsuarios.aspx" CssClass="nav-link" Text="Usuarios" />
                                    </li>
                                </asp:PlaceHolder>
                            </ul>
                        </nav>
                    </div>
                </aside>
                <main class="app-main">
                    <div class="app-content">
                        <div class="container-fluid py-3">
                            <asp:ContentPlaceHolder ID="ContenedorPrincipal" runat="server" />
                        </div>
                    </div>
                </main>


                <!--begin::Footer-->
                <footer class="app-footer">
                    <!--begin::Copyright-->
                    <strong>Liga de futbol Arnaldo Chacon Soto</strong>
                    <!--end::Copyright-->
                </footer>
                <!--end::Footer-->
            </div>

        </div>
    </form>
    <!--begin::Script-->
    <!--begin::Third Party Plugin(OverlayScrollbars)-->
    <script
        src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/browser/overlayscrollbars.browser.es6.min.js"
        crossorigin="anonymous"></script>
    <!--end::Third Party Plugin(OverlayScrollbars)-->
    <!--begin::Required Plugin(popperjs for Bootstrap 5)-->
    <script
        src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        crossorigin="anonymous"></script>
    <!--end::Required Plugin(popperjs for Bootstrap 5)-->
    <!--begin::Required Plugin(Bootstrap 5)-->
    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js"
        crossorigin="anonymous"></script>
    <!--end::Required Plugin(Bootstrap 5)-->
    <!--begin::Required Plugin(AdminLTE)-->
    <script src="<%=ResolveUrl("~/Vistas/js/adminlte.js") %>"></script>
    <!--end::Required Plugin(AdminLTE)-->
    <!--begin::OverlayScrollbars Configure-->
    <script>
const SELECTOR_SIDEBAR_WRAPPER = '.sidebar-wrapper';
const Default = {
    scrollbarTheme: 'os-theme-light',
    scrollbarAutoHide: 'leave',
    scrollbarClickScroll: true,
};

    </script>
    <!--end::OverlayScrollbars Configure-->
</body>
</html>
